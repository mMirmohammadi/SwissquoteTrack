# Isolated local launchers ignore ambient app configuration and refuse local dotenv files.
# Do not copy this to .env for local-demo.mjs/dev.mjs; these values document fixed defaults.
# Public-network configuration belongs to the separately owned Sepolia launcher.
CHAIN=local
RPC_URLS=http://127.0.0.1:8645,http://localhost:8645
SQ_PORT=4101
PORT=4101
PARTNER_PORT=4102
VITE_CHAIN=local
VITE_RPC_URLS=http://127.0.0.1:8645,http://localhost:8645
VITE_SQ_URL=http://localhost:4101
VITE_PARTNER_URL=http://localhost:4102
VITE_WALLET_PORT=5273
VITE_TOOL_PORT=5274
WEBAUTHN_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
# Data and unsafe deterministic fixture keys are supplied only by the local supervisor.
ALLOW_SEPOLIA_WRITES=false
PARTNER_DEMO_FOOLED=false
